node_modules/
.pnp
.pnp.js

# ── Build output ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Environment variables (never commit secrets) ─────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Vite / TypeScript cache ───────────────────────────────────────────────────
